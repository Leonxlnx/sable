{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"],
      "@desk/*": ["../src/*"],
      "@/*": ["../src/*"],
      "@m/*": ["src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vite.web.config.ts", "capacitor.config.ts", "../shared/protocol.ts", "../shared/speed.ts", "../src/lib/models.ts", "../src/lib/format.ts"]
}
