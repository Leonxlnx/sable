{
  "name": "sable-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sable on Android: your desktop's sessions over the home network.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build:web": "tsc --noEmit -p tsconfig.json && node ../node_modules/vite/bin/vite.js build --config vite.web.config.ts --configLoader runner",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync": "vite build && cap sync android",
    "apk": "node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "jsqr": "^1.4.0",
    "marked": "^16.4.2",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  }
}
